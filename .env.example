# ==========================================
# ClipCraft Configuration Template
# Copy this file to .env and populate keys
# ==========================================

# Active LLM Provider (gemini, groq, openai, ollama)
LLM_PROVIDER=gemini

# Cloud API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Speech-to-Text Whisper Settings
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# Storage & Logging
CLIPCRAFT_OUTPUT_DIR=output
CLIPCRAFT_LOG_LEVEL=INFO
PORT=8000

